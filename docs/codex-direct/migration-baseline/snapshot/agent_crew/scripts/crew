#!/usr/bin/env python3
"""共通契約とrepo hookを使うClaude/Codex起動入口。"""

import argparse
import json
import os
from pathlib import Path
import sys

from crew_hooks import load_queue
from codex_hook_state import launch_overrides


def launch_spec(root, runtime, arguments, task, environ):
    env = dict(environ)
    # 前のタスク・別repoのscopeを意図せず持ち越さない。
    env.pop("CREW_TASK_SLUG", None)
    env.pop("CREW_TASK_ROOT", None)
    env["QUEUE_FILE"] = str(root / ".claude/_queue.json")
    if task:
        queue = load_queue(root / ".claude/_queue.json")
        if not queue or not any(t["slug"] == task for t in queue["tasks"]):
            raise ValueError("指定タスクがrepoのqueueに存在しません")
        env["CREW_TASK_SLUG"] = task
        env["CREW_TASK_ROOT"] = str(root)
    if runtime == "claude":
        command = ["claude", "--setting-sources", "project", *arguments]
    else:
        command = ["codex", "-C", str(root), *launch_overrides(root, env), *arguments]
    return command, env


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task", help="Stopで検証する担当queue slug（この起動だけ）")
    parser.add_argument("--print-command", action="store_true", help="起動せずコマンドとscopeだけ表示")
    parser.add_argument("runtime", choices=("claude", "codex"))
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    try:
        command, env = launch_spec(root, args.runtime, args.arguments, args.task, os.environ)
    except (OSError, ValueError) as error:
        parser.error(str(error))
    if args.print_command:
        print(json.dumps({"cwd": str(root), "command": command, "scope": {
            k: env[k] for k in ("CREW_TASK_SLUG", "CREW_TASK_ROOT") if k in env
        }}, ensure_ascii=False))
        return
    os.chdir(root)
    os.execvpe(command[0], command, env)


if __name__ == "__main__":
    main()
