{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "statusMessage": "crew-hooks:claude:SessionStart",
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/crew_hooks.py\" --runtime claude --event SessionStart --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "statusMessage": "crew-hooks:claude:Stop",
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/crew_hooks.py\" --runtime claude --event Stop --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "statusMessage": "crew-hooks:claude:SubagentStop",
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/crew_hooks.py\" --runtime claude --event SubagentStop --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "statusMessage": "crew-hooks:claude:TaskCompleted",
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/crew_hooks.py\" --runtime claude --event TaskCompleted --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/queue.sh *)",
      "Bash(scripts/propose-lesson-rules.sh *)",
      "Bash(scripts/lessons.sh *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(jq *)",
      "Bash(chmod *)",
      "Bash(bash *)",
      "Bash(scripts/privacy-check.sh *)",
      "Bash(~/.claude/hooks/*)",
      "Bash(python3 *)",
      "Bash(scripts/token-report.py *)",
      "Bash(scripts/enforce-retro-stop.sh *)",
      "Bash(scripts/sprint-points.sh *)",
      "Edit(**)",
      "Bash(scripts/audit-scan.sh *)"
    ]
  }
}
